@page "/Factorial"
@rendermode InteractiveServer
<h3>Factorial</h3>
<input type="number" @bind="n" />
<h2>@n! = @f</h2>
<button class="btn btn-primary" @onclick="Calculate">Найти</button>
<hr />

@code {
    int n; //исходное число факториала
    int f = 1; //Факториал

    void Calculate()
    {
        for(int i=1; i <= n; ++i)
        {
            f *= i;
        }
    }
}
