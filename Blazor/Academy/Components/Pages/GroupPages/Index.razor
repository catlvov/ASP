@page "/groups"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<div class="controls">
    <h1>Группы</h1>

    <p>
        <a href="groups/create" class="btn btn-primary">Добавить</a>
    </p>
</div>

<QuickGrid Class="table" Items="context.Groups.Include(g => g.Direction)">
    <PropertyColumn Property="group => group.group_name" />
    <PropertyColumn Property="group => group.Direction.direction_name" />
    <PropertyColumn Property="group => group.start_date" />
    <PropertyColumn Property="group => group.start_time" />
    <PropertyColumn Property="group => new Week((int)(group.learning_day ?? 0))" />

    <TemplateColumn Context="group">
        @* <a href="@($"groups/edit?group_id={group.group_Id}")">Edit</a> | *@
        <a href="@($"groups/details?group_id={group.group_Id}")">Details</a> 
        @* <a href="@($"groups/delete?group_id={group.group_Id}")">Delete</a> *@
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
