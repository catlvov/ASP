@page "/groups/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@* <h1>Details</h1> *@

<div>
    @* <h2>Group</h2>
    <hr /> *@
    @if (group is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div class="controls">
            <h1>@group.group_name</h1>
            <a href="@($"/groups/edit?group_id={group.group_Id}")" class="btn btn-primary">Edit</a>
        </div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">group_name</dt>
                <dd class="col-sm-10">@group.group_name</dd>
            <dt class="col-sm-2">direction</dt>
                <dd class="col-sm-10">@group.Direction.direction_name</dd>
            <dt class="col-sm-2">start_date</dt>
                <dd class="col-sm-10">@group.start_date</dd>
            <dt class="col-sm-2">start_time</dt>
                <dd class="col-sm-10">@group.start_time</dd>
            <dt class="col-sm-2">learning_day</dt>
                 <dd class="col-sm-10">@(new Week((int)(group.learning_day ?? 0)))</dd>
        </dl>
        @* <div>
            <a href="@($"/groups/edit?group_id={group.group_Id}")">Edit</a> |
        </div> *@
        <a href="@($"/groups")" class="btn btn-primary">Back to List</a>
    }
</div>

@code {
    private Group? group;

    [SupplyParameterFromQuery]
    private int group_Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        group = await context.Groups.Include(g => g.Direction).FirstOrDefaultAsync(m => m.group_Id == group_Id);

        if (group is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
