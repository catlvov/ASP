@page "/directions/details"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@* <h1>Details</h1> *@

<div>
    @* <h2>Direction</h2>
    <hr /> *@
    @if (direction is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div class="controls">
            <h1>@direction.direction_name</h1>
            <a href="@($"/directions/edit?direction_id={direction.direction_id}")" class="btn btn-primary">Изменить</a>
            <hr />
        </div>
        @* <dl class="row">
            <dt class="col-sm-2">direction_name</dt>
            <dd class="col-sm-10">@direction.direction_name</dd>
        </dl>  *@
        <h2>Количество групп: @direction.Groups.Count</h2>
        @* <ul>
            @foreach (Group group in direction.Groups)
            {
                <li>@group.group_name</li>
            }
        </ul> *@
        <QuickGrid Items="direction.Groups.AsQueryable()" Class="table">
            <PropertyColumn Property="group => group.group_name"/>
            <PropertyColumn Property="group => group.start_date"/>
            <PropertyColumn Property="group => group.start_time"/>
            <PropertyColumn Property="group => group.learning_day"/>
            @* <PropertyColumn Property="direction => direction.direction_name"/> *@
        </QuickGrid>
        @* <div>
            <a href="@($"/directions")">Back to List</a>
        </div>  *@
    }
</div>

@code {
    private Direction? direction;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions.Include(d => d.Groups).FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (direction is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
