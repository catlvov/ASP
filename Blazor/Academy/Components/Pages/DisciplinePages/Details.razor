@page "/disciplines/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@* <h1>Details</h1> *@

<div>
    <h2>Discipline</h2>
    <hr />
    @if (discipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div class="controls">
            <h1>@discipline.discipline_name</h1>
            <a href="@($"/disciplines/edit?discipline_id={discipline.discipline_id}")" class="btn btn-primary">Редактировать</a>
        </div>
        <dl class="row">
            <dt class="col-sm-2">discipline_name</dt>     <dd class="col-sm-10">@discipline.discipline_name</dd>
            <dt class="col-sm-2">number_of_lessons</dt>   <dd class="col-sm-10">@discipline.number_of_lessons</dd>
        </dl>
        <div class="adjacent-disciplines">
            <div>
                <h4>Тербуемые дисциплины</h4>
                @if(discipline.RequiredDisciplines != null)
                {
                    <ul>
                        @foreach(RequiredDisciplines dd in discipline.RequiredDisciplines)
                        {
                                <li>@dd.RequiredDiscipline.discipline_name</li>
                        }
                    </ul>
                }
            </div>
            <div>
                <h4>Зависимые дисциплины</h4>
                @if(discipline.DependentDisciplines != null)
                {
                    <ul>
                        @foreach(DependentDisciplines dd in discipline.DependentDisciplines)
                        {
                                <li>@dd.DependentDiscipline.discipline_name</li>
                        }
                    </ul>
                }
            </div>
        </div>
        <hr />
        <h3>Преподователи @(discipline.TDR.Count)</h3>
        <ul>
            @foreach(TeachersDisciplinesRelation tdr in discipline.TDR)
            {
                <li>@tdr.Teacher.full_name</li>
            }
        </ul>
        @* <div>
            <a href="@($"/disciplines")">Back to List</a>
        </div> *@
    }
</div>

@code {
    private Discipline? discipline;

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Disciplines
                                        .Include(d => d.TDR).ThenInclude(tdr => tdr.Teacher)
                                        .Include(d => d.DependentDisciplines).ThenInclude(dd => dd.DependentDiscipline)
                                        .Include(d => d.RequiredDisciplines).ThenInclude(rd => rd.RequiredDiscipline)
                                        .FirstOrDefaultAsync(m => m.discipline_id == discipline_id);

        if (discipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
